+def _occupied_patch_origins(
+    surface_slice: np.ndarray,
+    stride: int,
+    *,
+    positive_only: bool = False,
+    validation: np.ndarray | None = None,
+) -> np.ndarray:
+    """Occupancy in row-major order without materializing nonzero pixel coordinates."""
+    height, width = surface_slice.shape
+    if validation is not None and validation.shape != surface_slice.shape:
+        raise ValueError(f"validation support {validation.shape} != supervision {surface_slice.shape}")
+    if not height or not width:
+        return np.empty((0, 2), dtype=np.intp)
+    columns = np.arange(0, width, stride)
+    # Sweep row bands so intermediate memory stays bounded even at stride 1.
+    band = max(stride, ((1 << 20) // width // stride) * stride)
+    origins = []
+    for top in range(0, height, band):
+        image = surface_slice[top:top + band]
+        if positive_only:
+            image = image > 0
+            if validation is not None:
+                image |= validation[top:top + band] > 0
+        row_cells = np.logical_or.reduceat(image, columns, axis=1)
+        cells = np.logical_or.reduceat(row_cells, np.arange(0, len(image), stride), axis=0)
+        points = np.argwhere(cells) * stride
+        points[:, 0] += top
+        origins.append(points)
+    return np.concatenate(origins)
+
